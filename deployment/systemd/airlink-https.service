[Unit]
Description=AirLink local-IP HTTPS certificate maintenance
After=network-online.target airlink-live-init.service
Wants=network-online.target
Before=nginx.service
ConditionPathExists=/etc/airlink/provisioned
[Service]
Type=oneshot
ExecStart=/opt/airlink/venv/bin/python /opt/airlink/deployment/dashboard_https.py
User=root
UMask=0077
[Install]
WantedBy=multi-user.target
