[Unit]
Description=AirLink alert evaluator and retention
After=postgresql.service redis-server.service airlink-live-init.service
Requires=postgresql.service redis-server.service
ConditionPathExists=/etc/airlink/provisioned
[Service]
User=airlink
Group=airlink
WorkingDirectory=/opt/airlink
EnvironmentFile=/etc/airlink/airlink.env
ExecStart=/opt/airlink/venv/bin/python -m monitoring.alerts
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
[Install]
WantedBy=multi-user.target
