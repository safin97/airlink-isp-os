[Unit]
Description=AirLink privileged local controller
After=NetworkManager.service airlink-live-init.service
ConditionPathExists=/etc/airlink/provisioned
[Service]
ExecStart=/usr/bin/python3 /opt/airlink/os/console/broker.py
RuntimeDirectory=airlink
RuntimeDirectoryMode=0755
Restart=on-failure
UMask=0077
ProtectHome=yes
PrivateTmp=yes
[Install]
WantedBy=multi-user.target
